# Copie este arquivo para .streamlit/secrets.toml e substitua os valores.
# Nunca envie o arquivo secrets.toml real ao Git.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "gere-uma-chave-aleatoria-forte"
client_id = "seu-client-id-do-provedor-oidc"
client_secret = "seu-client-secret-do-provedor-oidc"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
