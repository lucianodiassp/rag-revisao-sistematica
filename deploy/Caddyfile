{$RAG_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy app:8501 {
		health_uri /_stcore/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
