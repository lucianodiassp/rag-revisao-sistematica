# Copie para deploy/web.env. O arquivo real não deve ser enviado ao Git.

# Domínio público apontado para o servidor, sem https:// e sem caminho.
RAG_DOMAIN=rag.exemplo.org
RAG_DEPLOYMENT_PROFILE=web_private
RAG_USER_MODE=single_user
RAG_AUTH_ALLOWED_EMAILS=pesquisador@example.org

# Banco exclusivo da implantação Web. Substitua a senha antes de executar.
DB_NAME=rag_systematic_review
DB_USER=rag_web_user
DB_PASSWORD=troque-por-uma-senha-aleatoria-forte

# Limites operacionais.
RAG_MAX_UPLOAD_MB=2048
RAG_MAX_PDF_UPLOAD_MB=100
RAG_MAX_BACKUP_UPLOAD_MB=2048
RAG_MIN_FREE_STORAGE_MB=2048
RAG_UID=1000
RAG_GID=1000

# Fila persistente. Um único processo protege as cotas no perfil de usuário único.
RAG_JOB_WORKERS=1
RAG_JOB_POLL_SECONDS=2
RAG_JOB_HEARTBEAT_SECONDS=15
RAG_JOB_STALE_SECONDS=300
RAG_JOB_MAX_ATTEMPTS=3
RAG_JOB_RETRY_BASE_SECONDS=15
RAG_SERVICE_HEARTBEAT_SECONDS=15
RAG_SERVICE_STALE_SECONDS=60

# Backup externo agendado. Ative somente depois de preencher todos os campos.
RAG_EXTERNAL_BACKUP_ENABLED=false
RAG_EXTERNAL_BACKUP_SCHEDULE_HOUR_UTC=3
RAG_EXTERNAL_BACKUP_RETRY_MINUTES=60
RAG_EXTERNAL_BACKUP_LOCAL_RETENTION=3
RAG_EXTERNAL_BACKUP_REMOTE_RETENTION=14
RAG_EXTERNAL_BACKUP_PREFIX=rag-revisao-sistematica
RAG_EXTERNAL_BACKUP_REGION=us-east-1
RAG_EXTERNAL_BACKUP_ADDRESSING_STYLE=auto
# RAG_EXTERNAL_BACKUP_BUCKET=
# RAG_EXTERNAL_BACKUP_ENDPOINT_URL=https://endpoint-s3-do-provedor
# RAG_EXTERNAL_BACKUP_ACCESS_KEY_ID=
# RAG_EXTERNAL_BACKUP_SECRET_ACCESS_KEY=
# RAG_EXTERNAL_BACKUP_SESSION_TOKEN=
# RAG_EXTERNAL_BACKUP_PASSWORD=
# RAG_EXTERNAL_BACKUP_ALERT_WEBHOOK_URL=https://endpoint-privado-de-alertas

# Configuração inicial de IA. A chave também pode ser cadastrada pela interface.
AI_PROVIDER=google_gemini
AI_CONFIG_DATABASE_ENABLED=true
AI_DEFAULT_GENERATION_MODEL=gemini-3.6-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
# GEMINI_API_KEY=

# Chaves opcionais das fontes bibliográficas.
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# PUBMED_API_KEY=
