# Banco de dados local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_systematic_review
DB_USER=rag_user
DB_PASSWORD=rag_password

# Identidade da implantação (a versão do produto vem do arquivo VERSION)
RAG_DEPLOYMENT_PROFILE=local
RAG_USER_MODE=single_user
# Obrigatório apenas quando RAG_DEPLOYMENT_PROFILE=web_private.
# No modo single_user, informe exatamente um e-mail reconhecido pelo provedor OIDC.
# RAG_AUTH_ALLOWED_EMAILS=pesquisador@example.org

# Credencial do provedor atual
GEMINI_API_KEY="sua-chave-api-do-google-aqui"

# Configuração central de IA
AI_PROVIDER=google_gemini
AI_CONFIG_DATABASE_ENABLED=true
AI_DEFAULT_GENERATION_MODEL=gemini-3.6-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768

# Overrides opcionais por função. Remova o comentário apenas quando necessário.
# AI_FORMULATION_MODEL=gemini-3.6-flash
# AI_SCREENING_MODEL=gemini-3.6-flash
# AI_RAG_MODEL=gemini-3.6-flash
# AI_RERANKING_MODEL=gemini-3.6-flash
# AI_EVALUATION_MODEL=gemini-3.6-flash
# AI_EXTRACTION_MODEL=gemini-3.6-flash
# AI_METHOD_QUALITY_MODEL=gemini-3.6-flash
# AI_REPORT_MODEL=gemini-3.6-flash

# Temperaturas opcionais para modelos que ainda aceitam amostragem.
# Modelos Gemini recentes que não aceitam estes parâmetros são detectados.
# AI_FORMULATION_TEMPERATURE=0.2
# AI_SCREENING_TEMPERATURE=0.0
# AI_RAG_TEMPERATURE=0.1
# AI_RERANKING_TEMPERATURE=0.0
# AI_EVALUATION_TEMPERATURE=0.0
# AI_EXTRACTION_TEMPERATURE=0.0
# AI_METHOD_QUALITY_TEMPERATURE=0.0
# AI_REPORT_TEMPERATURE=0.2

# Reranking opcional da busca híbrida (fallback automático para RRF em falhas).
# AI_RERANKING_ENABLED=true
# AI_RERANKING_CANDIDATE_LIMIT=12
# AI_RERANKING_FINAL_LIMIT=4
# AI_RERANKING_RRF_WEIGHT=0.0

# Recuperação/implantação avançada da chave-mestra local (opcional).
# Por padrão, ela é criada no diretório de dados privado do usuário do sistema.
# AI_LOCAL_MASTER_KEY_PATH=C:\caminho\privado\master.key
# AI_LOCAL_MASTER_KEY=chave-fernet-gerenciada-externamente

# Chaves opcionais das bases bibliográficas
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# PUBMED_API_KEY=

# Identificação e comportamento das fontes (fallback para a configuração no banco).
# BIBLIOGRAPHIC_CONTACT_EMAIL=seu-email@instituicao.br
# BIBLIOGRAPHIC_TOOL_NAME=rag-revisao-sistematica
# BIBLIOGRAPHIC_TIMEOUT_SECONDS=30
# BIBLIOGRAPHIC_MAX_RETRIES=3
# OPENALEX_EMAIL=seu-email@instituicao.br
# SEMANTIC_SCHOLAR_EMAIL=seu-email@instituicao.br
# PUBMED_EMAIL=seu-email@instituicao.br
# PUBMED_TOOL=rag-revisao-sistematica
# OPENALEX_ENABLED=true
# SEMANTIC_SCHOLAR_ENABLED=true
# PUBMED_ENABLED=true
# OCR local de PDFs digitalizados (Tesseract)
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=por+eng
PDF_OCR_DPI=300
PDF_OCR_MIN_NATIVE_CHARACTERS=40
# PDF_OCR_TESSDATA=/caminho/para/tessdata
